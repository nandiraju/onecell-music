# Cloudflare R2 Audio Application Storage
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET=1cell-audio-library
R2_BUCKET_NAME=1cell-audio-library
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# S3-Compatible API Credentials
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Public Bucket URL (Managed R2.dev domain for audio streaming)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Vite Frontend Variables
VITE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
VITE_R2_BUCKET=1cell-audio-library
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
